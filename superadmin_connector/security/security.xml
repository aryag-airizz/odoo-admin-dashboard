<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_superadmin_connector" model="ir.module.category">
        <field name="name">Superadmin Connector</field>
        <field name="sequence">31</field>
    </record>

    <record id="privilege_superadmin_connector" model="res.groups.privilege">
        <field name="name">Superadmin Connector</field>
        <field name="category_id" ref="module_category_superadmin_connector"/>
    </record>

    <!--
        Deliberately NO implied_ids: the integration user must not inherit
        "Internal User" rights. API keys of this group are capped at 30 days
        (api_key_duration) so that they have to be rotated regularly.
    -->
    <record id="group_superadmin_connector" model="res.groups">
        <field name="name">Superadmin Integration</field>
        <field name="privilege_id" ref="privilege_superadmin_connector"/>
        <field name="api_key_duration">30</field>
        <field name="comment">Technical group for the API user of the central Superadmin Dashboard. Assign it to a dedicated portal user only.</field>
    </record>

</odoo>
