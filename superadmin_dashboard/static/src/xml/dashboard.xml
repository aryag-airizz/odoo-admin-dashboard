<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="superadmin_dashboard.Dashboard" owl="1">

        <div class="o_superadmin_dashboard p-4">

            <!-- Dashboard Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="mb-1">Superadmin Dashboard</h1>
                    <p class="text-muted mb-0">
                        Manage all your companies and Odoo databases
                    </p>
                </div>
            </div>

            <!-- Loading -->
            <div t-if="this.state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <p class="mt-2">Loading dashboard...</p>
            </div>

            <!-- Dashboard Statistics -->
            <div t-else="" class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <p class="text-muted mb-2">Total Companies</p>
                                    <h2 t-esc="this.state.stats.total_companies"/>
                                </div>
                                <i class="fa fa-building fa-2x text-primary"/>
                            </div>
                            <button class="btn btn-link px-0 mt-3"
                                    t-on-click="() => this.openCompanies()">
                                View Companies →
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <p class="text-muted mb-2">Active Companies</p>
                                    <h2 t-esc="this.state.stats.active_companies"/>
                                </div>
                                <i class="fa fa-check-circle fa-2x text-success"/>
                            </div>
                            <button class="btn btn-link px-0 mt-3"
                                    t-on-click="() => this.openCompanies()">
                                View Companies →
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <p class="text-muted mb-2">Total Databases</p>
                                    <h2 t-esc="this.state.stats.total_databases"/>
                                </div>
                                <i class="fa fa-database fa-2x text-info"/>
                            </div>
                            <button class="btn btn-link px-0 mt-3"
                                    t-on-click="() => this.openDatabases()">
                                View Databases →
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <p class="text-muted mb-2">Production Databases</p>
                                    <h2 t-esc="this.state.stats.production_databases"/>
                                </div>
                                <i class="fa fa-server fa-2x text-warning"/>
                            </div>
                            <button class="btn btn-link px-0 mt-3"
                                    t-on-click="() => this.openDatabases()">
                                View Databases →
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </t>

</templates>
