<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Database List -->
    <record id="view_superadmin_database_list" model="ir.ui.view">
        <field name="name">superadmin.database.list</field>
        <field name="model">superadmin.database</field>
        <field name="arch" type="xml">
            <list string="Databases">
                <field name="name"/>
                <field name="company_id"/>
                <field name="url"/>
                <field name="environment"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Database Form -->
    <record id="view_superadmin_database_form" model="ir.ui.view">
        <field name="name">superadmin.database.form</field>
        <field name="model">superadmin.database</field>
        <field name="arch" type="xml">
            <form string="Database">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="company_id"/>
                        <field name="url"/>
                        <field name="environment"/>
                        <field name="active"/>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Database Action -->
    <record id="action_superadmin_databases" model="ir.actions.act_window">
        <field name="name">Databases</field>
        <field name="res_model">superadmin.database</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
