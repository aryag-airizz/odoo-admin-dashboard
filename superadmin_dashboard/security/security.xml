<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_superadmin" model="ir.module.category">
        <field name="name">Superadmin Dashboard</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_superadmin_dashboard"
            model="res.groups.privilege">
        <field name="name">Superadmin Dashboard</field>
        <field name="category_id" ref="module_category_superadmin"/>
    </record>

    <record id="group_superadmin_dashboard" model="res.groups">
        <field name="name">Superadmin</field>
        <field name="privilege_id"
               ref="privilege_superadmin_dashboard"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>